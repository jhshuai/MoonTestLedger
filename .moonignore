# This replaces .gitignore during packaging: retain its cache/output exclusions.
_build/
/.mooncakes/
/.moon/
/target/
/output/
/examples/producers/maven/target/
/examples/producers/gradle/.gradle/
/examples/producers/gradle/build/
/examples/producers/pytest/__pycache__/
/examples/producers/pytest/.pytest_cache/

# Development measurements, intentional crash probes and maintenance automation
# stay in GitHub. Keep the two standalone, Git-independent user demos.
/cmd/benchmark/
/examples/benchmark/
/examples/diagnostics/
/scripts/*
!/scripts/workflow-demo.mbtx
!/scripts/render-demo.mbtx
