///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
}

///|
async fn moon(args : Array[String]) -> Unit {
  let command = @env.get_env_var("MOON_TEST_LEDGER_MOON").unwrap_or("moon")
  println("[verify:start] " + Json::array(args.map(Json::string)).stringify())
  let status = @shell.Cmd(command, args, stdout=Inherit, stderr=Inherit).status()
  if status != 0 {
    fail(
      "Verification command failed (status=\{status}, negative POSIX statuses are signals): \{command} " +
      Json::array(args.map(Json::string)).stringify(),
    )
  }
  println("[verify:ok] " + Json::array(args.map(Json::string)).stringify())
}

///|
async fn main {
  let target = @env.args().get(1).unwrap_or("wasm-gc")
  guard target == "wasm" ||
    target == "wasm-gc" ||
    target == "js" ||
    target == "native" else {
    fail("expected one of wasm, wasm-gc, js or native")
  }
  moon(["version", "--all"])
  moon(["run", "--deny-warn", "scripts/check-script-imports.mbtx"])
  moon(["fmt", "--check"])
  moon(["-C", "examples/consumer", "fmt", "--check"])
  moon([
    "fmt", "--check", "scripts/verify.mbtx", "scripts/e2e.mbtx", "scripts/check-encapsulation.mbtx",
    "scripts/render-demo.mbtx", "scripts/output-e2e.mbtx", "scripts/check-consumer.mbtx",
    "scripts/delivery-e2e.mbtx", "scripts/diagnose-native.mbtx", "scripts/check-producers.mbtx",
    "scripts/check-ci-delivery.mbtx", "scripts/check-golden-delivery.mbtx", "scripts/review-e2e.mbtx",
    "scripts/build-release.mbtx", "scripts/publish-release.mbtx", "scripts/workflow-demo.mbtx",
    "scripts/check-script-imports.mbtx", "scripts/check-native-memory.mbtx", "scripts/benchmark.mbtx",
  ])
  let paths = [
    "pkg.generated.mbti", "ledger/pkg.generated.mbti", "junit/pkg.generated.mbti",
    "wire/pkg.generated.mbti", "cli/pkg.generated.mbti", "cmd/moontestledger/pkg.generated.mbti",
    "history/pkg.generated.mbti", "report/pkg.generated.mbti", "cmd/benchmark/pkg.generated.mbti",
  ]
  let before : Array[String] = []
  for path in paths {
    before.push(@fs.read_file(path).text())
  }
  moon(["info", "--target", "wasm"])
  for index, path in paths {
    assert_eq(before[index], @fs.read_file(path).text())
  }
  moon(["check", "--target", target, "--deny-warn"])
  moon(["build", "--target", target, "--deny-warn"])
  moon(["test", "--target", target, "--deny-warn"])
  moon(["run", "--deny-warn", "scripts/check-encapsulation.mbtx"])
  moon(["run", "--deny-warn", "scripts/check-producers.mbtx", target])
  if target == "wasm" || target == "native" {
    moon(["run", "--deny-warn", "scripts/workflow-demo.mbtx", target])
    moon(["run", "--deny-warn", "scripts/review-e2e.mbtx", target])
    moon(["run", "--deny-warn", "scripts/check-golden-delivery.mbtx", target])
    moon(["run", "scripts/e2e.mbtx", target])
    moon(["run", "--deny-warn", "scripts/output-e2e.mbtx", target])
    moon(["run", "--deny-warn", "scripts/delivery-e2e.mbtx", target])
  }
}
