///|
import {
  "hustcer/fzip@0.8.8",
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn html_cli(target : String, path : String) -> String {
  let command = @env.get_env_var("MOON_TEST_LEDGER_MOON").unwrap_or("moon")
  let output = @shell.Cmd(command, [
    "run", "--target", target, "cmd/moontestledger", "--", "html", path,
  ]).output(max_output_bytes=4194304)
  assert_eq(output.exit_code(), 0)
  let page = output.stdout()
  assert_true(page.has_prefix("<!doctype html>"))
  assert_true(!page.contains("<script"))
  assert_true(page.contains("Declared reports and original XML"))
  page
}

///|
async fn cli(target : String, args : Array[String], expected : Int32) -> Json {
  let command = @env.get_env_var("MOON_TEST_LEDGER_MOON").unwrap_or("moon")
  let output = @shell.Cmd(
    command,
    ["run", "--target", target, "cmd/moontestledger", "--", ..args],
  ).output(max_output_bytes=4194304)
  if output.exit_code() != expected {
    fail(
      "CLI exit \{output.exit_code()} expected \{expected}: \{output.stderr()}",
    )
  }
  assert_eq(output.exit_code(), expected)
  if expected == 2 {
    @json.parse(output.stderr())
  } else {
    @json.parse(output.stdout())
  }
}

///|
async fn carrier_workflow(
  target : String,
  format : String,
  archive : Json,
  summary : Json,
  gate : Int32,
) -> Unit {
  let directory = @fs.tmpdir(prefix="moontestledger-carrier")
  defer @fs.rmdir(directory)
  let source = directory + "/source.json"
  let packed = directory + "/evidence." + format
  defer @fs.remove(source)
  defer @fs.remove(packed)
  @fs.write_file(source, archive.stringify())
  ignore(cli(target, [format + "-pack", source, packed], 0))
  let original = @fs.read_file(packed).binary()
  assert_eq(cli(target, ["restore-" + format, packed], 0), archive)
  assert_eq(cli(target, ["verify-" + format, packed], gate), summary)
  ignore(cli(target, [format + "-pack", source, packed], 2))
  let unchanged = @fs.read_file(packed).binary()
  assert_eq(unchanged, original)
  @fs.write_file(packed, original[:21])
  ignore(cli(target, ["restore-" + format, packed], 2))
  @fs.write_file(packed, original)
  assert_eq(cli(target, ["verify-" + format, packed], gate), summary)
}

///|
async fn pack_workflow(
  target : String,
  archive : Json,
  summary : Json,
  gate : Int32,
) -> Unit {
  let directory = @fs.tmpdir(prefix="moontestledger-pack")
  defer @fs.rmdir(directory)
  let source = directory + "/source.json"
  defer @fs.remove(source)
  @fs.write_file(source, archive.stringify())
  let destination = directory + "/new-pack"
  let owned : Array[String] = []
  defer {
    for path in owned {
      @fs.remove(path)
    }
    @fs.rmdir(destination)
  }
  let index = cli(target, ["detach", source, destination], 0)
  owned.push(destination + "/index.json")
  guard index is { "integrity": { "documents": Array(receipts), .. }, .. } else {
    fail("Expected detached index")
  }
  let names : Set[String] = Set([])
  for receipt in receipts {
    guard receipt is { "sha256": String(hash), .. } else {
      fail("Expected receipt")
    }
    names.add("sha256-" + hash + ".xml")
  }
  for name in names {
    owned.push(destination + "/" + name)
  }
  assert_eq(cli(target, ["restore-pack", destination], 0), archive)
  assert_eq(cli(target, ["verify-pack", destination], gate), summary)
  // Existing destinations are refused, preserving the existing complete pack.
  ignore(cli(target, ["detach", source, destination], 2))
  assert_eq(cli(target, ["verify-pack", destination], gate), summary)
  let extra = destination + "/undeclared.txt"
  @fs.write_file(extra, "not a declared artifact")
  let refused = cli(target, ["verify-pack", destination], 2)
  guard refused is { "error": { "code": String("UnexpectedPackFile"), .. }, .. } else {
    fail("Closed member set must reject extras")
  }
  @fs.remove(extra)
  for name in names {
    let member_path = destination + "/" + name
    let original = @fs.read_file(member_path).text()
    @fs.write_file(member_path, original + "\n")
    let changed = cli(target, ["restore-pack", destination], 2)
    guard changed
      is { "error": { "code": String("IntegrityMismatch"), .. }, .. } else {
      fail("Raw XML corruption must fail")
    }
    @fs.remove(member_path)
    let missing = cli(target, ["restore-pack", destination], 2)
    guard missing is { "error": { "code": String("MissingPackFile"), .. }, .. } else {
      fail("Accepted pack member cannot disappear")
    }
    @fs.mkdir(member_path)
    let special = cli(target, ["restore-pack", destination], 2)
    guard special is { "error": { "code": String("PackFileKind"), .. }, .. } else {
      fail("Directory must not be accepted as XML")
    }
    @fs.rmdir(member_path)
    @fs.write_file(member_path, original)
    break
  }
  assert_eq(cli(target, ["restore-pack", destination], 0), archive)
  assert_eq(cli(target, ["verify-pack", destination], gate), summary)
}

///|
async fn collection_workflow(
  target : String,
  archive : Json,
  summary : Json,
) -> Unit {
  let root = @fs.tmpdir(prefix="moontestledger-collect")
  defer @fs.rmdir(root)
  let spec_path = root + "/collection.json"
  defer @fs.remove(spec_path)
  let output = root + "/evidence.json"
  defer @fs.remove(output)
  let spec = @json.parse(
    @fs.read_file("examples/upstream/collection.json").text(),
  )
  guard spec is { "files": [Object(file)], .. } else {
    fail("Expected one declared XML artifact")
  }
  file["path"] = Json::string("job/jest.xml")
  @fs.write_file(spec_path, spec.stringify())
  let pending = cli(target, ["collect", spec_path, root], 0)
  @fs.write_file(output, pending.stringify())
  let missing = cli(target, ["verify", output], 3)
  guard missing is { "missing_reports": [String("jest-main")], .. } else {
    fail("Missing directory artifact must remain declared")
  }
  let subdirectory = root + "/job"
  @fs.mkdir(subdirectory)
  defer @fs.rmdir(subdirectory)
  let report = subdirectory + "/jest.xml"
  defer @fs.remove(report)
  let original = @fs.read_file("examples/upstream/jest-junit.xml").text()
  @fs.write_file(report, original)
  let noise = subdirectory + "/unrelated.txt"
  @fs.write_file(noise, b"\xff")
  defer @fs.remove(noise)
  let collected = cli(target, ["collect", spec_path, root], 0)
  assert_eq(collected, archive)
  assert_eq(cli(target, ["collect", spec_path, root], 0), collected)
  @fs.write_file(output, collected.stringify())
  assert_eq(cli(target, ["verify", output], 1), summary)
  @fs.write_file(report, "<testsuite><testcase name='wrong'/></testsuite>")
  let invalid = cli(target, ["collect", spec_path, root], 2)
  guard invalid is { "error": { "code": String("UnexpectedCase"), .. }, .. } else {
    fail("Collection cannot adopt an undeclared testcase")
  }
  @fs.write_file(report, b"\xff")
  let malformed = cli(target, ["collect", spec_path, root], 2)
  guard malformed is { "error": { "code": String("InvalidUtf8"), .. }, .. } else {
    fail("Declared malformed bytes must be refused")
  }
  @fs.write_file(report, original)
  assert_eq(cli(target, ["collect", spec_path, root], 0), archive)
  @fs.write_file(
    spec_path,
    spec.stringify().replace(old="job/jest.xml", new="../jest.xml"),
  )
  let traversal = cli(target, ["collect", spec_path, root], 2)
  guard traversal is { "error": { "code": String("CollectionPath"), .. }, .. } else {
    fail("Traversal must be refused before file access")
  }
  @fs.write_file(
    spec_path,
    @fs.read_file("examples/retry/collection.json").text(),
  )
  let retry = cli(target, ["collect", spec_path, "examples/retry"], 0)
  @fs.write_file(output, retry.stringify())
  ignore(cli(target, ["verify", output], 1))
}

///|
async fn write_collection_zip(
  path : String,
  entries : Array[(String, Bytes)],
) -> Unit {
  let bytes = @fzip.zip_sync_checked(
    entries.map(pair => (pair.0, pair.1.to_fixedarray())),
  )
  @fs.write_file(path, Bytes::from_array(bytes[:]))
}

///|
async fn zip_collection_workflow(
  target : String,
  archive : Json,
  summary : Json,
) -> Unit {
  let directory = @fs.tmpdir(prefix="moontestledger-collect-zip")
  defer @fs.rmdir(directory)
  let packed = directory + "/reports.zip"
  let output = directory + "/evidence.json"
  defer @fs.remove(packed)
  defer @fs.remove(output)
  let spec = "examples/upstream/collection.json"
  write_collection_zip(packed, [])
  let pending = cli(target, ["collect-zip", spec, packed], 0)
  @fs.write_file(output, pending.stringify())
  let missing = cli(target, ["verify", output], 3)
  guard missing is { "missing_reports": [String("jest-main")], .. } else {
    fail("ZIP must retain declared missing reports")
  }
  let original = @fs.read_file("examples/upstream/jest-junit.xml").binary()
  write_collection_zip(packed, [("jest-junit.xml", original)])
  assert_eq(cli(target, ["collect-zip", spec, packed], 0), archive)
  @fs.write_file(output, archive.stringify())
  assert_eq(cli(target, ["verify", output], 1), summary)
  write_collection_zip(packed, [
    ("jest-junit.xml", original),
    ("unlisted.txt", b"\xff"),
  ])
  let extra = cli(target, ["collect-zip", spec, packed], 2)
  guard extra is { "error": { "code": String("UnexpectedArtifact"), .. }, .. } else {
    fail("ZIP collection cannot silently discard extras")
  }
  write_collection_zip(packed, [("jest-junit.xml", b"\xff")])
  let invalid = cli(target, ["collect-zip", spec, packed], 2)
  guard invalid is { "error": { "code": String("InvalidUtf8"), .. }, .. } else {
    fail("Declared XML must be strict UTF8")
  }
  @fs.write_file(packed, b"bad ZIP")
  ignore(cli(target, ["collect-zip", spec, packed], 2))
  write_collection_zip(packed, [("jest-junit.xml", original)])
  assert_eq(cli(target, ["collect-zip", spec, packed], 0), archive)
  let retry_spec = "examples/retry/collection.json"
  let first = @fs.read_file("examples/retry/first.xml").binary()
  let second = @fs.read_file("examples/retry/second.xml").binary()
  write_collection_zip(packed, [("first.xml", first)])
  @fs.write_file(
    output,
    cli(target, ["collect-zip", retry_spec, packed], 0).stringify(),
  )
  ignore(cli(target, ["verify", output], 3))
  write_collection_zip(packed, [("second.xml", second), ("first.xml", first)])
  let recovered = cli(target, ["collect-zip", retry_spec, packed], 0)
  assert_eq(
    recovered,
    cli(target, ["collect", retry_spec, "examples/retry"], 0),
  )
  @fs.write_file(output, recovered.stringify())
  ignore(cli(target, ["verify", output], 1))
}

///|
async fn tar_collection_workflow(
  target : String,
  archive : Json,
  summary : Json,
) -> Unit {
  let directory = @fs.tmpdir(prefix="moontestledger-collect-tar")
  defer @fs.rmdir(directory)
  let packed = directory + "/reports.tar"
  let output = directory + "/evidence.json"
  let changed_spec = directory + "/collection.json"
  defer @fs.remove(packed)
  defer @fs.remove(output)
  defer @fs.remove(changed_spec)
  let spec = "examples/upstream/collection.json"
  @fs.write_file(changed_spec, @fs.read_file(spec))
  @fs.write_file(packed, Bytes::make(1024, b'\x00'))
  let pending = cli(target, ["collect-tar", spec, packed], 0)
  @fs.write_file(output, pending.stringify())
  let missing = cli(target, ["verify", output], 3)
  guard missing is { "missing_reports": [String("jest-main")], .. } else {
    fail("USTAR must retain the full declared inventory")
  }
  let reference = @fs.read_file("examples/transport/jest-reports.tar").binary()
  @fs.write_file(packed, reference)
  assert_eq(cli(target, ["collect-tar", spec, packed], 0), archive)
  @fs.write_file(output, archive.stringify())
  assert_eq(cli(target, ["verify", output], 1), summary)
  let corrupted = reference.to_array()
  corrupted[512] = b'\xff'
  @fs.write_file(packed, Bytes::from_array(corrupted[:]))
  let invalid = cli(target, ["collect-tar", spec, packed], 2)
  guard invalid is { "error": { "code": String("InvalidUtf8"), .. }, .. } else {
    fail("USTAR collection must reject malformed XML bytes")
  }
  @fs.write_file(packed, reference[:511])
  ignore(cli(target, ["collect-tar", spec, packed], 2))
  @fs.write_file(packed, reference)
  @fs.write_file(
    changed_spec,
    @fs.read_file(spec)
    .text()
    .replace(old="jest-junit.xml", new="Jest-junit.xml"),
  )
  let wrong_case = cli(target, ["collect-tar", changed_spec, packed], 2)
  guard wrong_case
    is { "error": { "code": String("UnexpectedArtifact"), .. }, .. } else {
    fail("Archive casing must exactly match declaration")
  }
  assert_eq(cli(target, ["collect-tar", spec, packed], 0), archive)
  let retry_spec = "examples/retry/collection.json"
  @fs.write_file(packed, @fs.read_file("examples/transport/retry-first.tar"))
  @fs.write_file(
    output,
    cli(target, ["collect-tar", retry_spec, packed], 0).stringify(),
  )
  ignore(cli(target, ["verify", output], 3))
  @fs.write_file(packed, @fs.read_file("examples/transport/retry-reports.tar"))
  let retry = cli(target, ["collect-tar", retry_spec, packed], 0)
  assert_eq(retry, cli(target, ["collect", retry_spec, "examples/retry"], 0))
  @fs.write_file(output, retry.stringify())
  ignore(cli(target, ["verify", output], 1))
}

///|
async fn main {
  let target = @env.args().get(1).unwrap_or("wasm")
  assert_true(target == "wasm" || target == "native")
  let version = cli(target, ["--version"], 0)
  let mut module_version = ""
  for line in @fs.read_file("moon.mod").text().split("\n") {
    if line.split_once("=") is Some((key, value)) && key.trim() == "version" {
      guard @json.parse(value.trim().to_owned()) is String(value) else {
        fail("module version must be a string")
      }
      module_version = value
    }
  }
  guard version
    is {
      "version": String(actual),
      "delivery_profiles": [String("mtl-ci-delivery-v1")],
      ..
    } else {
    fail("expected machine-readable CLI version")
  }
  assert_eq(actual, module_version)
  assert_true(!module_version.is_empty())
  let original = cli(
    target,
    ["audit", "examples/upstream/plan.json", "examples/upstream/bundle.json"],
    1,
  )
  guard original is { "complete": True, "cases": Array(cases), .. } else {
    fail("upstream Jest report should be complete")
  }
  assert_eq(cases.length(), 6)
  assert_eq(
    cases
    .iter()
    .filter(value => value is { "verdict": String("failed"), .. })
    .count(),
    4,
  )
  let missing = cli(
    target,
    [
      "audit", "examples/upstream/plan.json", "examples/upstream/missing-bundle.json",
    ],
    3,
  )
  guard missing is { "complete": False, "missing_reports": Array(reports), .. } else {
    fail("missing artifact must remain incomplete")
  }
  assert_eq(reports.length(), 1)
  let captured = cli(target, ["capture", "examples/upstream/bundle.json"], 0)
  guard captured is { "reports": Array(reports), .. } else {
    fail("capture should return a versioned run plan")
  }
  assert_eq(reports.length(), 1)
  let recovered = cli(
    target,
    ["audit", "examples/retry/plan.json", "examples/retry/bundle.json"],
    0,
  )
  guard recovered is { "complete": True, "cases": Array(cases), .. } else {
    fail("selective retry should complete the plan")
  }
  guard cases
    .iter()
    .find_first(value => {
      value is { "verdict": String("recovered_on_retry"), .. }
    })
    is Some(value) else {
    fail("retry must retain a recovered verdict")
  }
  guard value is { "attempts": Array(attempts), .. } else {
    fail("recovered evidence needs original and retry observations")
  }
  assert_eq(attempts.length(), 2)
  let denied = cli(
    target,
    [
      "audit", "examples/retry/plan.json", "examples/retry/bundle.json", "--deny-recovered",
    ],
    1,
  )
  guard denied is { "exit_code": Number(1, ..), .. } else {
    fail("recovery gate should return exit code 1")
  }
  let invalid = cli(
    target,
    ["capture", "examples/upstream/invalid-bundle.json"],
    2,
  )
  guard invalid
    is {
      "error": { "code": String(_), "report_id": String("pytest-mismatch"), .. },
      ..
    } else {
    fail("invalid upstream counter needs a structured diagnostic")
  }
  let directory = @fs.tmpdir(prefix="moontestledger-evidence")
  defer @fs.rmdir(directory)
  let path = directory + "/evidence.json"
  defer @fs.remove(path)
  let archive = cli(
    target,
    ["archive", "examples/upstream/plan.json", "examples/upstream/bundle.json"],
    0,
  )
  @fs.write_file(path, archive.stringify(indent=2))
  let real_page = html_cli(target, path)
  assert_true(real_page.contains("Gate: <strong>failing</strong>"))
  assert_true(real_page.contains("&lt;testsuites"))
  assert_eq(html_cli(target, path), real_page)
  let replayed = cli(target, ["verify", path], 1)
  assert_eq(replayed, original)
  let unchanged = cli(target, ["compare", path, path], 0)
  guard unchanged is { "comparable": True, "changes": Array(changes), .. } else {
    fail("Expected a conclusive self-comparison")
  }
  assert_eq(changes.length(), 6)
  let other_path = directory + "/other.json"
  defer @fs.remove(other_path)
  let incomplete_archive = cli(
    target,
    [
      "archive", "examples/upstream/plan.json", "examples/upstream/missing-bundle.json",
    ],
    0,
  )
  @fs.write_file(path, incomplete_archive.stringify())
  assert_true(html_cli(target, path).contains("Missing report:"))
  assert_eq(cli(target, ["verify", path], 3), missing)
  @fs.write_file(other_path, archive.stringify())
  let unknown = cli(target, ["compare", other_path, path], 3)
  guard unknown is { "comparable": False, .. } else {
    fail("Missing evidence cannot pass comparison")
  }
  let strict_archive = cli(
    target,
    [
      "archive", "examples/retry/plan.json", "examples/retry/bundle.json", "--deny-recovered",
    ],
    0,
  )
  @fs.write_file(path, strict_archive.stringify())
  assert_eq(cli(target, ["verify", path], 1), denied)
  let before = cli(
    target,
    [
      "archive", "examples/history/before-plan.json", "examples/history/before-bundle.json",
    ],
    0,
  )
  let after = cli(
    target,
    [
      "archive", "examples/history/after-plan.json", "examples/history/after-bundle.json",
    ],
    0,
  )
  @fs.write_file(path, before.stringify())
  @fs.write_file(other_path, after.stringify())
  let comparison = cli(target, ["compare", path, other_path], 1)
  guard comparison is { "comparable": True, "changes": Array(changes), .. } else {
    fail("Expected complete comparison")
  }
  assert_eq(
    changes
    .iter()
    .filter(change => change is { "kind": String("regressed"), .. })
    .count(),
    1,
  )
  assert_eq(
    changes
    .iter()
    .filter(change => change is { "kind": String("improved"), .. })
    .count(),
    1,
  )
  let refused = cli(target, ["merge", path, other_path], 2)
  guard refused is { "error": { "code": String("MergePlanMismatch"), .. }, .. } else {
    fail("Different runs must not be merged")
  }
  let initial = cli(
    target,
    [
      "archive", "examples/retry/plan.json", "examples/retry/missing-bundle.json",
    ],
    0,
  )
  let retry = cli(
    target,
    [
      "archive", "examples/retry/plan.json", "examples/retry/retry-only-bundle.json",
    ],
    0,
  )
  @fs.write_file(path, initial.stringify())
  @fs.write_file(other_path, retry.stringify())
  let merged = cli(target, ["merge", path, other_path, path], 0)
  assert_eq(merged, cli(target, ["merge", other_path, path], 0))
  @fs.write_file(path, merged.stringify())
  assert_eq(cli(target, ["verify", path], 0), recovered)
  let recovered_page = html_cli(target, path)
  assert_true(recovered_page.contains("recovered_on_retry"))
  assert_true(recovered_page.contains("Attempt 1 · failed"))
  assert_true(recovered_page.contains("Attempt 2 · passed"))
  assert_eq(cli(target, ["html"], 2), cli(target, ["merge"], 2))
  @fs.write_file(path, "{\"schema\":2}")
  let invalid_html = cli(target, ["html", path], 2)
  guard invalid_html is { "error": { "code": String(_), .. }, .. } else {
    fail("Invalid evidence must produce a diagnostic instead of HTML")
  }
  let initial_run = cli(
    target,
    [
      "archive", "examples/continuation/plan.json", "examples/continuation/bundle.json",
    ],
    0,
  )
  @fs.write_file(path, initial_run.stringify())
  let scheduled = cli(
    target,
    ["retry", path, "examples/continuation/reports.json"],
    0,
  )
  @fs.write_file(path, scheduled.stringify())
  let pending = cli(target, ["verify", path], 3)
  guard pending is { "missing_reports": [String("payments-2")], .. } else {
    fail("Scheduled retry must remain missing")
  }
  let continued = cli(
    target,
    ["append", path, "examples/retry/retry-only-bundle.json"],
    0,
  )
  @fs.write_file(path, continued.stringify())
  assert_eq(cli(target, ["verify", path], 0), recovered)
  assert_eq(
    cli(target, ["append", path, "examples/retry/retry-only-bundle.json"], 0),
    continued,
  )
  let no_retry = cli(
    target,
    ["retry", path, "examples/continuation/reports.json"],
    2,
  )
  guard no_retry is { "error": { "code": String("NoRetryCases"), .. }, .. } else {
    fail("Recovered tests must not be rescheduled")
  }
  let repeat_a = cli(
    target,
    [
      "archive", "examples/repetitions/plan-a.json", "examples/repetitions/bundle-a.json",
    ],
    0,
  )
  let repeat_b = cli(
    target,
    [
      "archive", "examples/repetitions/plan-b.json", "examples/repetitions/bundle-b.json",
    ],
    0,
  )
  @fs.write_file(path, repeat_a.stringify())
  @fs.write_file(other_path, repeat_b.stringify())
  let observations = cli(target, ["repetitions", path, other_path], 1)
  guard observations is { "complete": True, "cases": Array(rows), .. } else {
    fail("Expected complete repeated-run observations")
  }
  assert_eq(
    rows
    .iter()
    .filter(row => row is { "kind": String("mixed_outcomes"), .. })
    .count(),
    1,
  )
  assert_eq(cli(target, ["repetitions", other_path, path], 1), observations)
  let duplicate = cli(target, ["repetitions", path, path], 2)
  guard duplicate is { "error": { "code": String("DuplicateRun"), .. }, .. } else {
    fail("Duplicate runs must not inflate observations")
  }
  let repeat_missing = cli(
    target,
    [
      "archive", "examples/repetitions/plan-b.json", "examples/repetitions/missing-bundle.json",
    ],
    0,
  )
  @fs.write_file(other_path, repeat_missing.stringify())
  let inconclusive = cli(target, ["repetitions", path, other_path], 3)
  guard inconclusive is { "complete": False, .. } else {
    fail("Missing repeated-run evidence must be inconclusive")
  }
  @fs.write_file(path, archive.stringify())
  let manifest = cli(target, ["integrity", path], 0)
  // Independent Get-FileHash SHA-256 values of the exact indent-2 UTF-8
  // encoder outputs without a trailing newline; freeze mtl-evidence-v1.
  guard manifest
    is {
      "archive_sha256": String(archive_hash),
      "plan_sha256": String(plan_hash),
      ..
    } else {
    fail("Expected canonical archive and inventory hashes")
  }
  assert_eq(
    archive_hash, "1fc6df0a332c2648e14246c0670fd8d7f94d19d05d36f93678fb932e16a0411e",
  )
  assert_eq(
    plan_hash, "544790a21bb9d6c444de05a0a4414358bd3b8b2ab7136cad1e5477c3da113794",
  )
  guard manifest is { "documents": [{ "sha256": String(hash), .. }], .. } else {
    fail("Expected one real Jest receipt")
  }
  assert_eq(
    hash, "8e18da3a6e4252c34fe7899fad28f8eceeb43849329989b36f2ff68dc7698e58",
  )
  @fs.write_file(other_path, manifest.stringify())
  assert_eq(cli(target, ["check-integrity", path, other_path], 1), original)
  let reformatted = archive.stringify(indent=4)
  @fs.write_file(path, reformatted)
  assert_eq(cli(target, ["integrity", path], 0), manifest)
  assert_eq(cli(target, ["check-integrity", path, other_path], 1), original)
  @fs.write_file(
    path,
    reformatted.replace(old="<testsuites", new="<testsuites "),
  )
  let tampered = cli(target, ["check-integrity", path, other_path], 2)
  guard tampered
    is {
      "error": {
        "code": String("IntegrityMismatch"),
        "path": String(diagnostic_path),
        ..
      },
      ..
    } else {
    fail("Changed original XML must fail integrity")
  }
  assert_true(diagnostic_path.contains("/documents/"))
  @fs.write_file(path, incomplete_archive.stringify())
  let incomplete_manifest = cli(target, ["integrity", path], 0)
  @fs.write_file(other_path, incomplete_manifest.stringify())
  assert_eq(cli(target, ["check-integrity", path, other_path], 3), missing)
  @fs.write_file(path, strict_archive.stringify())
  @fs.write_file(other_path, cli(target, ["integrity", path], 0).stringify())
  assert_eq(cli(target, ["check-integrity", path, other_path], 1), denied)
  @fs.write_file(path, merged.stringify())
  @fs.write_file(other_path, cli(target, ["integrity", path], 0).stringify())
  assert_eq(cli(target, ["check-integrity", path, other_path], 0), recovered)
  @fs.write_file(other_path, "{\"schema\":2}")
  ignore(cli(target, ["check-integrity", path, other_path], 2))
  @fs.write_file(other_path, cli(target, ["integrity", path], 0).stringify())
  assert_eq(cli(target, ["check-integrity", path, other_path], 0), recovered)
  pack_workflow(target, archive, original, 1)
  pack_workflow(target, incomplete_archive, missing, 3)
  collection_workflow(target, archive, original)
  zip_collection_workflow(target, archive, original)
  tar_collection_workflow(target, archive, original)
  for format in ["zip", "tar"] {
    carrier_workflow(target, format, archive, original, 1)
    carrier_workflow(target, format, incomplete_archive, missing, 3)
    carrier_workflow(target, format, strict_archive, denied, 1)
    carrier_workflow(target, format, merged, recovered, 0)
  }
  println(
    "End-to-end checks passed on \{target}: real Jest, retry continuation, repetitions, archives, integrity/tampering, file packs, declared collection, merging, offline HTML, policy, comparison and malformed counters.",
  )
}
