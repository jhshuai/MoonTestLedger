///|
import {
  "moonbitlang/async",
  "moonbitlang/async/shell",
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn html_cli(target : String, path : String) -> String {
  let command = @env.get_env_var("MOON_TEST_LEDGER_MOON").unwrap_or("moon")
  let output = @shell.Cmd(command, [
    "run", "--target", target, "cmd/moontestledger", "--", "html", path,
  ]).output(max_output_bytes=4194304)
  assert_eq(output.exit_code(), 0)
  let page = output.stdout()
  assert_true(page.has_prefix("<!doctype html>"))
  assert_true(!page.contains("<script"))
  assert_true(page.contains("Declared reports and original XML"))
  page
}

///|
async fn cli(target : String, args : Array[String], expected : Int32) -> Json {
  let command = @env.get_env_var("MOON_TEST_LEDGER_MOON").unwrap_or("moon")
  let output = @shell.Cmd(
    command,
    ["run", "--target", target, "cmd/moontestledger", "--", ..args],
  ).output(max_output_bytes=4194304)
  if output.exit_code() != expected {
    fail(
      "CLI exit \{output.exit_code()} expected \{expected}: \{output.stderr()}",
    )
  }
  assert_eq(output.exit_code(), expected)
  if expected == 2 {
    @json.parse(output.stderr())
  } else {
    @json.parse(output.stdout())
  }
}

///|
async fn main {
  let target = @env.args().get(1).unwrap_or("wasm")
  assert_true(target == "wasm" || target == "native")
  let original = cli(
    target,
    ["audit", "examples/upstream/plan.json", "examples/upstream/bundle.json"],
    1,
  )
  guard original is { "complete": True, "cases": Array(cases), .. } else {
    fail("upstream Jest report should be complete")
  }
  assert_eq(cases.length(), 6)
  assert_eq(
    cases
    .iter()
    .filter(value => value is { "verdict": String("failed"), .. })
    .count(),
    4,
  )
  let missing = cli(
    target,
    [
      "audit", "examples/upstream/plan.json", "examples/upstream/missing-bundle.json",
    ],
    3,
  )
  guard missing is { "complete": False, "missing_reports": Array(reports), .. } else {
    fail("missing artifact must remain incomplete")
  }
  assert_eq(reports.length(), 1)
  let captured = cli(target, ["capture", "examples/upstream/bundle.json"], 0)
  guard captured is { "reports": Array(reports), .. } else {
    fail("capture should return a versioned run plan")
  }
  assert_eq(reports.length(), 1)
  let recovered = cli(
    target,
    ["audit", "examples/retry/plan.json", "examples/retry/bundle.json"],
    0,
  )
  guard recovered is { "complete": True, "cases": Array(cases), .. } else {
    fail("selective retry should complete the plan")
  }
  guard cases
    .iter()
    .find_first(value => {
      value is { "verdict": String("recovered_on_retry"), .. }
    })
    is Some(value) else {
    fail("retry must retain a recovered verdict")
  }
  guard value is { "attempts": Array(attempts), .. } else {
    fail("recovered evidence needs original and retry observations")
  }
  assert_eq(attempts.length(), 2)
  let denied = cli(
    target,
    [
      "audit", "examples/retry/plan.json", "examples/retry/bundle.json", "--deny-recovered",
    ],
    1,
  )
  guard denied is { "exit_code": Number(1, ..), .. } else {
    fail("recovery gate should return exit code 1")
  }
  let invalid = cli(
    target,
    ["capture", "examples/upstream/invalid-bundle.json"],
    2,
  )
  guard invalid
    is {
      "error": { "code": String(_), "report_id": String("pytest-mismatch"), .. },
      ..
    } else {
    fail("invalid upstream counter needs a structured diagnostic")
  }
  let directory = @fs.tmpdir(prefix="moontestledger-evidence")
  defer @fs.rmdir(directory)
  let path = directory + "/evidence.json"
  defer @fs.remove(path)
  let archive = cli(
    target,
    ["archive", "examples/upstream/plan.json", "examples/upstream/bundle.json"],
    0,
  )
  @fs.write_file(path, archive.stringify(indent=2))
  let real_page = html_cli(target, path)
  assert_true(real_page.contains("Gate: <strong>failing</strong>"))
  assert_true(real_page.contains("&lt;testsuites"))
  assert_eq(html_cli(target, path), real_page)
  let replayed = cli(target, ["verify", path], 1)
  assert_eq(replayed, original)
  let unchanged = cli(target, ["compare", path, path], 0)
  guard unchanged is { "comparable": True, "changes": Array(changes), .. } else {
    fail("Expected a conclusive self-comparison")
  }
  assert_eq(changes.length(), 6)
  let other_path = directory + "/other.json"
  defer @fs.remove(other_path)
  let incomplete_archive = cli(
    target,
    [
      "archive", "examples/upstream/plan.json", "examples/upstream/missing-bundle.json",
    ],
    0,
  )
  @fs.write_file(path, incomplete_archive.stringify())
  assert_true(html_cli(target, path).contains("Missing report:"))
  assert_eq(cli(target, ["verify", path], 3), missing)
  @fs.write_file(other_path, archive.stringify())
  let unknown = cli(target, ["compare", other_path, path], 3)
  guard unknown is { "comparable": False, .. } else {
    fail("Missing evidence cannot pass comparison")
  }
  let strict_archive = cli(
    target,
    [
      "archive", "examples/retry/plan.json", "examples/retry/bundle.json", "--deny-recovered",
    ],
    0,
  )
  @fs.write_file(path, strict_archive.stringify())
  assert_eq(cli(target, ["verify", path], 1), denied)
  let before = cli(
    target,
    [
      "archive", "examples/history/before-plan.json", "examples/history/before-bundle.json",
    ],
    0,
  )
  let after = cli(
    target,
    [
      "archive", "examples/history/after-plan.json", "examples/history/after-bundle.json",
    ],
    0,
  )
  @fs.write_file(path, before.stringify())
  @fs.write_file(other_path, after.stringify())
  let comparison = cli(target, ["compare", path, other_path], 1)
  guard comparison is { "comparable": True, "changes": Array(changes), .. } else {
    fail("Expected complete comparison")
  }
  assert_eq(
    changes
    .iter()
    .filter(change => change is { "kind": String("regressed"), .. })
    .count(),
    1,
  )
  assert_eq(
    changes
    .iter()
    .filter(change => change is { "kind": String("improved"), .. })
    .count(),
    1,
  )
  let refused = cli(target, ["merge", path, other_path], 2)
  guard refused is { "error": { "code": String("MergePlanMismatch"), .. }, .. } else {
    fail("Different runs must not be merged")
  }
  let initial = cli(
    target,
    [
      "archive", "examples/retry/plan.json", "examples/retry/missing-bundle.json",
    ],
    0,
  )
  let retry = cli(
    target,
    [
      "archive", "examples/retry/plan.json", "examples/retry/retry-only-bundle.json",
    ],
    0,
  )
  @fs.write_file(path, initial.stringify())
  @fs.write_file(other_path, retry.stringify())
  let merged = cli(target, ["merge", path, other_path, path], 0)
  assert_eq(merged, cli(target, ["merge", other_path, path], 0))
  @fs.write_file(path, merged.stringify())
  assert_eq(cli(target, ["verify", path], 0), recovered)
  let recovered_page = html_cli(target, path)
  assert_true(recovered_page.contains("recovered_on_retry"))
  assert_true(recovered_page.contains("Attempt 1 · failed"))
  assert_true(recovered_page.contains("Attempt 2 · passed"))
  assert_eq(cli(target, ["html"], 2), cli(target, ["merge"], 2))
  @fs.write_file(path, "{\"schema\":2}")
  let invalid_html = cli(target, ["html", path], 2)
  guard invalid_html is { "error": { "code": String(_), .. }, .. } else {
    fail("Invalid evidence must produce a diagnostic instead of HTML")
  }
  let initial_run = cli(
    target,
    [
      "archive", "examples/continuation/plan.json", "examples/continuation/bundle.json",
    ],
    0,
  )
  @fs.write_file(path, initial_run.stringify())
  let scheduled = cli(
    target,
    ["retry", path, "examples/continuation/reports.json"],
    0,
  )
  @fs.write_file(path, scheduled.stringify())
  let pending = cli(target, ["verify", path], 3)
  guard pending is { "missing_reports": [String("payments-2")], .. } else {
    fail("Scheduled retry must remain missing")
  }
  let continued = cli(
    target,
    ["append", path, "examples/retry/retry-only-bundle.json"],
    0,
  )
  @fs.write_file(path, continued.stringify())
  assert_eq(cli(target, ["verify", path], 0), recovered)
  assert_eq(
    cli(target, ["append", path, "examples/retry/retry-only-bundle.json"], 0),
    continued,
  )
  let no_retry = cli(
    target,
    ["retry", path, "examples/continuation/reports.json"],
    2,
  )
  guard no_retry is { "error": { "code": String("NoRetryCases"), .. }, .. } else {
    fail("Recovered tests must not be rescheduled")
  }
  let repeat_a = cli(
    target,
    [
      "archive", "examples/repetitions/plan-a.json", "examples/repetitions/bundle-a.json",
    ],
    0,
  )
  let repeat_b = cli(
    target,
    [
      "archive", "examples/repetitions/plan-b.json", "examples/repetitions/bundle-b.json",
    ],
    0,
  )
  @fs.write_file(path, repeat_a.stringify())
  @fs.write_file(other_path, repeat_b.stringify())
  let observations = cli(target, ["repetitions", path, other_path], 1)
  guard observations is { "complete": True, "cases": Array(rows), .. } else {
    fail("Expected complete repeated-run observations")
  }
  assert_eq(
    rows
    .iter()
    .filter(row => row is { "kind": String("mixed_outcomes"), .. })
    .count(),
    1,
  )
  assert_eq(cli(target, ["repetitions", other_path, path], 1), observations)
  let duplicate = cli(target, ["repetitions", path, path], 2)
  guard duplicate is { "error": { "code": String("DuplicateRun"), .. }, .. } else {
    fail("Duplicate runs must not inflate observations")
  }
  let repeat_missing = cli(
    target,
    [
      "archive", "examples/repetitions/plan-b.json", "examples/repetitions/missing-bundle.json",
    ],
    0,
  )
  @fs.write_file(other_path, repeat_missing.stringify())
  let inconclusive = cli(target, ["repetitions", path, other_path], 3)
  guard inconclusive is { "complete": False, .. } else {
    fail("Missing repeated-run evidence must be inconclusive")
  }
  println(
    "End-to-end checks passed on \{target}: real Jest, retry continuation, repetitions, archives, merging, offline HTML, policy, comparison and malformed counters.",
  )
}
