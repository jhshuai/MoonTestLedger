///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/crypto",
}

///|
async fn capture(
  root : String,
  name : String,
  cwd : String,
  program : String,
  args : Array[String],
) -> (Int32, String, String) {
  @fs.write_file(
    root + "/" + name + ".command.json",
    Json::object({
      "program": Json::string(program),
      "arguments": Json::array(args.map(Json::string)),
    }).stringify(indent=2),
    create_mode=CreateNew,
  )
  let result = @shell.Cmd(
    program,
    args,
    cwd~,
    env=Map([("LC_ALL", "C"), ("MOONBIT_ALLOCATOR", "mimalloc")]),
  ).output(max_output_bytes=16777216)
  @fs.write_file(
    root + "/" + name + ".stdout",
    result.stdout_bytes(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + name + ".stderr",
    result.stderr(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + name + ".status",
    result.exit_code().to_string(),
    create_mode=CreateNew,
  )
  println("[benchmark] " + name + ": status=\{result.exit_code()}")
  (result.exit_code(), result.stdout(), result.stderr())
}

///|
async fn checked(
  root : String,
  name : String,
  cwd : String,
  program : String,
  args : Array[String],
) -> String {
  let (code, output, error) = capture(root, name, cwd, program, args)
  guard code == 0 else {
    fail(
      "Benchmark stopped at " +
      name +
      "; logs retained at " +
      root +
      ": " +
      error,
    )
  }
  output
}

///|
async fn main {
  guard @env.args() is [_, destination] else {
    fail(
      "usage: moon run scripts/benchmark.mbtx NEW-DIRECTORY (Linux GNU time)",
    )
  }
  let platform = @shell.Cmd("uname", ["-s"]).output() catch {
    _ => fail("Peak RSS collection requires Linux and GNU /usr/bin/time")
  }
  guard platform.exit_code() == 0 && platform.stdout().trim() == "Linux" else {
    fail(
      "Peak RSS collection requires Linux and GNU /usr/bin/time; the workload itself supports all library targets",
    )
  }
  @fs.mkdir(destination)
  let root = @fs.realpath(destination)
  let cwd = @fs.realpath(".")
  let moon = @env.get_env_var("MOON_TEST_LEDGER_MOON").unwrap_or("moon")
  let version = checked(root, "toolchain", cwd, moon, ["version", "--all"])
  let compiler = checked(root, "compiler", cwd, "cc", ["--version"])
  let system = checked(root, "system", cwd, "uname", ["-srm"])
  let cpu = checked(root, "cpu", cwd, "lscpu", ["--json"])
  let timer = checked(root, "timer", cwd, "/usr/bin/time", ["--version"])
  assert_true(timer.contains("GNU"))
  let revision = checked(root, "revision", cwd, "git", ["rev-parse", "HEAD"])
    .trim()
    .to_owned()
  let status = checked(root, "workspace", cwd, "git", [
    "status", "--porcelain", "--untracked-files=all",
  ])
  ignore(
    checked(root, "build", cwd, moon, [
      "build", "--release", "--target", "native", "--deny-warn", "cmd/benchmark",
    ]),
  )
  let plan = checked(root, "build-plan", cwd, moon, [
    "run", "--release", "--target", "native", "--dry-run", "cmd/benchmark", "--",
    "1000",
  ])
  assert_true(plan.contains("-DMOONBIT_ALLOCATOR=MOONBIT_ALLOCATOR_MIMALLOC"))
  assert_true(!plan.contains("-fsanitize="))
  let binary = cwd + "/_build/native/release/build/cmd/benchmark/benchmark.exe"
  let binary_hash = @crypto.bytes_to_hex_string(
    @crypto.sha256(@fs.read_file(binary).binary()),
  )
  let (invalid, invalid_output, diagnostic) = capture(
    root,
    "invalid-count",
    cwd,
    binary,
    ["0"],
  )
  assert_eq(invalid, 2)
  assert_eq(diagnostic, "")
  assert_true(
    @json.parse(invalid_output)
    is { "error": { "code": String("BenchmarkSize"), .. }, .. },
  )
  let samples : Array[Json] = []
  let summaries : Array[Json] = []
  for count in [1000, 10000, 100000] {
    let elapsed : Array[Double] = []
    let rss : Array[Double] = []
    let mut previous : Json? = None
    let mut last : Json = Json::null()
    for round in 1..<=3 {
      let name = "\{count}-\{round}"
      let output = checked(root, name, cwd, "timeout", [
        "180",
        "/usr/bin/time",
        "-f",
        "{\"elapsed_seconds\": %e, \"peak_rss_kib\": %M, \"exit_code\": %x}",
        "-o",
        root + "/" + name + ".time.json",
        binary,
        count.to_string(),
      ])
      let workload = @json.parse(output)
      guard workload
        is {
          "cases": Number(actual, ..),
          "gate": Number(1, ..),
          "checks_passed": True,
          "xml_sha256": xml_hash,
          "archive_sha256": archive_hash,
          ..
        } else {
        fail("Invalid workload result")
      }
      assert_eq(actual, count.to_double())
      let digest = Json::array([xml_hash, archive_hash])
      if previous is Some(previous) {
        assert_eq(digest, previous)
      }
      previous = Some(digest)
      let timing = @fs.read_file(root + "/" + name + ".time.json").json()
      guard timing
        is {
          "elapsed_seconds": Number(seconds, ..),
          "peak_rss_kib": Number(memory, ..),
          "exit_code": Number(0, ..),
          ..
        } &&
        seconds >= 0 &&
        memory > 0 else {
        fail("Invalid GNU time result")
      }
      elapsed.push(seconds)
      rss.push(memory)
      last = workload
      samples.push(
        Json::object({
          "count": Json::number(actual),
          "round": Json::number(round.to_double()),
          "workload": workload,
          "process": timing,
        }),
      )
    }
    elapsed.sort()
    rss.sort()
    guard last is { "xml_bytes": xml_bytes, "archive_bytes": archive_bytes, .. } else {
      fail("Missing workload sizes")
    }
    summaries.push(
      Json::object({
        "cases": Json::number(count.to_double()),
        "median_elapsed_seconds": Json::number(elapsed[1]),
        "max_peak_rss_kib": Json::number(rss[2]),
        "xml_bytes": xml_bytes,
        "archive_bytes": archive_bytes,
      }),
    )
  }
  @fs.write_file(
    root + "/results.json",
    Json::object({
      "schema": Json::number(1),
      "informational": Json::boolean(true),
      "source_revision": Json::string(revision),
      "workspace_dirty": Json::boolean(!status.trim().is_empty()),
      "binary_sha256": Json::string(binary_hash),
      "allocator": Json::string("mimalloc"),
      "toolchain": Json::string(version),
      "compiler": Json::string(compiler),
      "system": Json::string(system),
      "cpu": @json.parse(cpu),
      "summaries": Json::array(summaries),
      "samples": Json::array(samples),
    }).stringify(indent=2) +
    "\n",
    create_mode=CreateNew,
  )
  println(
    "Nine fresh-process samples passed, including exact XML/JSON replay and resource refusal/recovery. Timings are informational. Retained results: " +
    root,
  )
}
